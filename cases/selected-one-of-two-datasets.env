# allDatasets=false with ONE of two top-level datasets selected (by name). Known issue kept: the app still
# processes every dataset (the Sampling widget's "all datasets" checkbox is never unchecked), see MODERNIZE.md.
# Source: dev project 9491 "tvpi-src two datasets" (team 1 / workspace 733; 64x64 videos copied from #7894).
TEAM_ID=1
WORKSPACE_ID=733
PROJECT_ID=9491
modal.state.slyProjectId=9491
modal.state.Options=all
modal.state.allDatasets=false
modal.state.selectedDatasets=["dsA"]
modal.state.includeNestedDatasets=false
modal.state.sampleResultFrames=false
modal.state.framesStep=10
modal.state.copyAnnotations=true
modal.state.run=true
modal.state.batchSize=32
